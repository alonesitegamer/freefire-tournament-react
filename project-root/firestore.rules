rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The browser is intentionally denied direct Firestore access in Phase 3.
    // All application reads/writes go through authenticated API endpoints.
    match /users/{uid} { allow read, write: if false; }
    match /matches/{matchId} { allow read, write: if false; }
    match /matchSecrets/{matchId} { allow read, write: if false; }
    match /topupRequests/{requestId} { allow read, write: if false; }
    match /withdrawRequests/{requestId} { allow read, write: if false; }
    match /matchHistory/{historyId} { allow read, write: if false; }
    match /feedback/{feedbackId} { allow read, write: if false; }
    match /otpRequests/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /adminActions/{id} { allow read, write: if false; }
    match /economyLedger/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
